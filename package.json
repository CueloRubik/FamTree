{
  "name": "famtree",
  "productName": "FamTree",
  "version": "4.3.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "prestart": "node tools/icons.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:icons": "node tools/icons.cjs && node tests/icons.mjs",
    "build:win": "node tools/icons.cjs && electron-builder --win nsis --x64",
    "build:win:dir": "node tools/icons.cjs && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.cuelorubik.famtree",
    "productName": "FamTree",
    "asar": true,
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "assets/**",
      "desktop/**",
      "build/icon.png",
      "package.json",
      "data/demo.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": null,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "fileAssociations": [
      {
        "ext": "ftree",
        "name": "Árbol genealógico FamTree",
        "description": "Documento FamTree",
        "icon": "document.ico",
        "role": "Editor"
      },
      {
        "ext": "famtree",
        "name": "Árbol genealógico FamTree (anterior)",
        "description": "Documento FamTree anterior",
        "icon": "document.ico",
        "role": "Editor"
      }
    ]
  },
  "description": "FamTree · editor genealógico personal",
  "author": "CueloRubik"
}
